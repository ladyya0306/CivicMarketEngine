# Copy this file to .env for local development.
# Do not commit .env or real API keys.

# Offline and CI-friendly default.
LLM_MOCK_MODE=true

# Optional live LLM key. Replace the placeholder with your own key only when
# running live calls. The template intentionally avoids real key-like values.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional external services.
JINA_API_KEY=replace-with-your-jina-api-key
COHERE_API_KEY=replace-with-your-cohere-api-key
GOOGLE_API_KEY=replace-with-your-google-api-key
SEARCH_ENGINE_ID=replace-with-your-search-engine-id
OPENWEATHERMAP_API_KEY=replace-with-your-openweathermap-api-key
